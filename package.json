{
  "name": "zichaoyang-com",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "generate-types": "wrangler types && astro sync",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"src/**/*.{css,astro}\" --max-warnings=0",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "astro build && playwright test",
    "e2e:serve": "node tests/e2e/server/prepare-e2e-database.ts && wrangler dev --port 8790 --persist-to .wrangler/e2e-state --env-file tests/e2e/e2e.env --infer-origin-from-routes=false --show-interactive-dev-session=false --log-level=warn",
    "verify": "npm run format:check && npm run lint && npm run lint:css && npm run check && npm run knip && npm run test:coverage",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.10",
    "@astrojs/react": "7.1.9",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "elkjs": "0.12.1",
    "fontkit": "2.0.4",
    "katex": "0.19.1",
    "marked": "18.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "roughjs": "4.6.6",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/cloudflare": "14.4.9",
    "@cloudflare/vitest-plugin": "1.9.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint-react/eslint-plugin": "5.30.6",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/fontkit": "2.0.9",
    "@types/mdast": "4.0.4",
    "@types/node": "25.9.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-istanbul": "5.1.1",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "knip": "6.47.0",
    "lefthook": "2.2.2",
    "postcss-html": "2.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  },
  "engines": {
    "node": "^26.11.0",
    "npm": ">=11.21.0"
  },
  "packageManager": "npm@11.21.0",
  "allowScripts": {
    "workerd@1.20261119.1": true,
    "workerd@1.20261117.1": true,
    "esbuild@0.28.2": true,
    "fsevents": false,
    "lefthook": false
  },
  "overrides": {
    "katex": "$katex",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "6.1.6"
    },
    "eslint-plugin-jsx-a11y-x": {
      "minimatch": "11.0.9"
    }
  }
}
