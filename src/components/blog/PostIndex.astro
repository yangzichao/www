---
import BlogSidebar from '../BlogSidebar.astro';
import { formatPostDate, type CategoryGroup } from '../../lib/posts';
import { postUrl, type PostSection } from '../../lib/post-sections';
import '../../styles/blog-layout.css';

interface Props {
  section: PostSection;
  groups: CategoryGroup[];
  subtitle: string;
}

const { section, groups, subtitle } = Astro.props;
---

<div class="blog-layout">
  <BlogSidebar groups={groups} section={section} />
  <div class="blog-main" data-depth-stagger>
    <header class="writing-head" data-depth-reveal>
      <a class="page-back-link" href="/">
        ← Home
      </a>
      <h1 class="page-title">{section.label}</h1>
      <p class="page-subtitle">{subtitle}</p>
    </header>

    {groups.map((group) => (
      <section class="category" id={group.slug} data-depth-reveal>
        <h2 class="section-title">{group.label}</h2>
        <ul class="post-list">
          {group.posts.map((post) => (
            <li class="post-row">
              <a class="post-row-link" href={postUrl(section, post.id)}>
                <span class="post-row-title">
                  {post.data.title}
                  {post.data.draft && <span class="post-row-draft">Draft</span>}
                </span>
                <time class="post-row-date" datetime={post.data.date.toISOString()}>
                  {formatPostDate(post.data.date)}
                </time>
              </a>
              {post.data.description && <p class="post-row-desc">{post.data.description}</p>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</div>

<style>
  .writing-head {
    margin-bottom: 3.5rem;
  }

  .category {
    margin-bottom: 3.5rem;
  }

  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .post-row {
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .post-row:last-child {
    border-bottom: 0;
  }

  .post-row-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    text-decoration: none;
    color: var(--color-text-main);
  }

  .post-row-title {
    font-size: 1.125rem;
    font-weight: 550;
    line-height: 1.35;
    transition: color var(--transition);
  }

  .post-row-draft {
    margin-left: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    padding: 2px 6px;
    color: var(--tone-coral-ink);
    background: var(--tone-coral-surface);
    border-radius: 4px;
    vertical-align: middle;
  }

  .post-row-link:hover .post-row-title {
    color: var(--color-link);
  }

  .post-row-date {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .post-row-desc {
    margin-top: 0.4rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
    max-width: 65ch;
  }

  @media (width <= 640px) {
    .post-row-link {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
