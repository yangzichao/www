---
import BlogSidebar from '../BlogSidebar.astro';
import ContentViewToolbar from '../../features/content-view/ContentViewToolbar.astro';
import type { ContentViewQuery } from '../../features/content-view/content-view-query';
import type { TagCount } from '../../features/content-view/content-view-selection';
import { formatPostCreatedDate, formatPostEditedDate } from '../../features/posts/post-date-format';
import type { CategoryGroup } from '../../features/posts/post-grouping';
import { BLOG_BASE_PATH, postUrl } from '../../features/posts/post-path';
import { NEW_POST_URL } from '../../features/posts/post-view';
import '../../styles/blog-layout.css';

interface Props {
  sidebarGroups: CategoryGroup[];
  shownGroups: CategoryGroup[];
  query: ContentViewQuery;
  tagCounts: TagCount[];
  countLabel: string;
  isAdmin: boolean;
  subtitle: string;
}

const { sidebarGroups, shownGroups, query, tagCounts, countLabel, isAdmin, subtitle } = Astro.props;
---

<div class="blog-layout">
  <BlogSidebar groups={sidebarGroups} />
  <div class="blog-main" data-depth-stagger>
    <header class="writing-head" data-depth-reveal>
      <a class="back-home" href="/">
        ← Home
      </a>
      <h1 class="writing-title">Writing</h1>
      <p class="writing-sub">{subtitle}</p>
      {isAdmin && (
        <p class="writing-admin">
          <a href={NEW_POST_URL}>New post</a>
          <a href="/api/posts/export" download>
            Export JSON
          </a>
        </p>
      )}
    </header>

    <ContentViewToolbar
      basePath={BLOG_BASE_PATH}
      query={query}
      tagCounts={tagCounts}
      showVisibilityFilter={isAdmin}
      searchLabel="Search posts"
    />

    {shownGroups.map((group) => (
      <section class="category" id={group.category} data-depth-reveal>
        <h2 class="section-title">{group.label}</h2>
        <ul class="post-list">
          {group.posts.map((post) => (
            <li class="post-row" data-post-path={post.path}>
              <a class="post-row-link" href={postUrl(post.path)}>
                <span class="post-row-title">
                  {post.title}
                  {!post.isPublic && <span class="post-row-private">Private</span>}
                </span>
                <span class="post-row-dates">
                  <time datetime={post.createdAt}>{formatPostCreatedDate(post, 'short')}</time>
                  {post.updatedAt && (
                    <span class="post-row-edited">
                      Edited <time datetime={post.updatedAt}>{formatPostEditedDate(post.updatedAt, 'short')}</time>
                    </span>
                  )}
                </span>
              </a>
              {post.description && <p class="post-row-desc">{post.description}</p>}
            </li>
          ))}
        </ul>
      </section>
    ))}
    {shownGroups.length === 0 && <p class="writing-empty">No posts match.</p>}

    <p class="writing-count">{countLabel}</p>
  </div>
</div>

<style>
  .writing-head {
    margin-bottom: 2rem;
  }

  .back-home {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: 1.5rem;
    transition: color var(--transition);
  }

  .back-home:hover {
    color: var(--color-text-main);
  }

  .writing-title {
    font-size: 2.75rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-text-main);
  }

  .writing-sub {
    margin-top: 0.75rem;
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  .writing-admin {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
    font-size: 0.9rem;
  }

  .writing-admin a {
    color: var(--color-text-main);
  }

  .writing-empty,
  .writing-count {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .category {
    margin-bottom: 3.5rem;
  }

  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .post-row {
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .post-row:last-child {
    border-bottom: 0;
  }

  .post-row-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    text-decoration: none;
    color: var(--color-text-main);
  }

  .post-row-title {
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    transition: color var(--transition);
  }

  .post-row-private {
    margin-left: 0.6rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    vertical-align: middle;
  }

  .post-row-link:hover .post-row-title {
    color: var(--color-text-muted);
  }

  .post-row-dates {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .post-row-edited {
    font-size: 0.75rem;
    font-style: italic;
  }

  .post-row-desc {
    margin-top: 0.4rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    max-width: 65ch;
  }

  @media (width <= 640px) {
    .writing-title {
      font-size: 2.25rem;
    }

    .post-row-link {
      flex-direction: column;
      gap: 0.25rem;
    }

    .post-row-dates {
      align-items: flex-start;
    }
  }
</style>
