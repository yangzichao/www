---
import { cn } from 'cn';
import { buttonVariants } from '@/components/ui/button';
import type { Profile, SitePageLink } from '../data/site';

interface Props {
  profile: Profile;
  sitePages: SitePageLink[];
}

const { profile, sitePages } = Astro.props;
const linkButtonClass = cn(
  buttonVariants({ variant: 'secondary', size: 'lg' }),
  'link-button h-auto bg-clip-border leading-[inherit]',
);
---

<header class="header">
  <div class="header-content" data-depth-reveal>
    <h1 class="name">{profile.name}</h1>
    <div class="bio">{profile.bio}</div>

    <div class="links">
      {profile.social.map((item) => (
        <a href={item.url} target="_blank" rel="noopener noreferrer" class={linkButtonClass}>
          <i class={`ph ${item.icon}`} />
          {item.label}
        </a>
      ))}
      {sitePages.map((page) => (
        <a href={page.url} class={linkButtonClass}>
          <i class={`ph ${page.icon}`} />
          {page.label}
        </a>
      ))}
    </div>
  </div>

  <div
    class="header-avatar-frame"
    data-depth-reveal
    style="

--reveal-delay: 120ms"
  >
    <img class="header-avatar" data-parallax-depth="16" alt={`${profile.name} avatar`} src={profile.avatar} />
  </div>
</header>
