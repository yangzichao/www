---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostIndex from '../../components/blog/PostIndex.astro';
import { getPublishedPosts, groupByCategory } from '../../lib/posts';
import { WRITING_SECTION } from '../../lib/post-sections';

const subtitle = 'Notes and essays on physics, systems, AI, and life.';
const groups = groupByCategory(await getPublishedPosts());
---

<BaseLayout title="Writing — Zichao Yang" description={subtitle}>
  <PostIndex section={WRITING_SECTION} groups={groups} subtitle={subtitle} />
</BaseLayout>
