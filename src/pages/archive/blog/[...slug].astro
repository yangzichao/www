---
import { getEntry, render } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';
import { checkAdminPageAccess } from '../../../features/admin/admin-page-guard';
import { markAsPrivatePage, privateNotFoundResponse } from '../../../features/archive/private-page-headers';
import { ARCHIVE_SECTION } from '../../../lib/post-sections';

export const prerender = false;

const access = await checkAdminPageAccess(Astro.cookies, Astro.url.pathname, { requiresRepositoryAccess: false });
if (access.kind === 'redirect') return Astro.redirect(access.location);

const post = Astro.params.slug === undefined ? undefined : await getEntry('archive', Astro.params.slug);
if (!post) return privateNotFoundResponse();
markAsPrivatePage(Astro.response.headers);

const { Content, headings } = await render(post);
---

<PostLayout frontmatter={post.data} id={post.id} headings={headings} section={ARCHIVE_SECTION}>
  <Content />
</PostLayout>
