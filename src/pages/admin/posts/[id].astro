---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PostEditorApp from '../../../features/posts/editor/PostEditorApp';
import { checkAdminPageAccess } from '../../../features/admin/admin-page-guard';
import { toEditablePost } from '../../../features/posts/editor/post-draft';
import { privateNotFoundResponse } from '../../../features/http/private-page-headers';
import { findPostById } from '../../../features/posts/store/post-store';
import 'katex/dist/katex.min.css';
import '../../../styles/post.css';
import '../../../styles/whiteboard-diagram.css';

export const prerender = false;

const access = await checkAdminPageAccess(Astro.cookies, Astro.url.pathname);
if (access.kind === 'redirect') return Astro.redirect(access.location);
const post = Astro.params.id ? await findPostById(env.DB, Astro.params.id) : null;
if (!post) return privateNotFoundResponse();
Astro.response.headers.set('cache-control', 'no-store');
---

<AdminLayout title={`Edit · ${post.title}`} activeSection="posts" signedInAs={access.user.githubLogin}>
  <PostEditorApp client:only="react" initialPost={toEditablePost(post)} />
</AdminLayout>
