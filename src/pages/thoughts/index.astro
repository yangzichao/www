---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThoughtComposer from '../../features/thoughts/components/ThoughtComposer';
import ThoughtDeleteButton from '../../features/thoughts/components/ThoughtDeleteButton';
import { loadCurrentUser } from '../../features/auth/current-session';
import { listThoughtsNewestFirst } from '../../features/thoughts/thought-store';
import { describeThoughtCount, toThoughtFeedItem } from '../../features/thoughts/thought-feed';

export const prerender = false;

const viewer = await loadCurrentUser(Astro.cookies);
const isAdmin = viewer?.isAdmin ?? false;
const feedItems = (await listThoughtsNewestFirst(env.DB)).map(toThoughtFeedItem);
Astro.response.headers.set('cache-control', 'no-store');
---

<BaseLayout title="Thoughts — Zichao Yang" description="Short thoughts, observations, and fragments.">
  <div class="thoughts-layout">
    <header class="thoughts-head">
      <a class="back-home" href="/">
        ← Home
      </a>
      <h1 class="thoughts-title">Thoughts</h1>
      <p class="thoughts-sub">Short observations, posted as they come.</p>
    </header>

    {isAdmin && (
      <section class="thoughts-admin" aria-label="Post a thought">
        <ThoughtComposer client:load />
        <p class="thoughts-export">
          Export all:
          <a href="/api/thoughts/export?format=markdown" download>
            Markdown
          </a>
          ·
          <a href="/api/thoughts/export?format=json" download>
            JSON
          </a>
        </p>
      </section>
    )}

    <div class="thoughts-feed">
      {feedItems.map((item) => (
        <article class="thought-card" data-thought-id={item.id}>
          <div class="thought-meta">
            <time class="thought-date" datetime={item.createdAt}>
              {item.displayTimestamp}
            </time>
            {item.tags.length > 0 && (
              <div class="thought-tags">
                {item.tags.map((tag) => (
                  <span class="thought-tag">{tag}</span>
                ))}
              </div>
            )}
            {isAdmin && (
              <span class="thought-actions">
                <ThoughtDeleteButton client:visible thoughtId={item.id} />
              </span>
            )}
          </div>
          <div class="thought-body prose" set:html={item.html} />
        </article>
      ))}
    </div>

    <footer class="thoughts-footer">
      <span class="thoughts-count">{describeThoughtCount(feedItems.length)}</span>
    </footer>
  </div>
</BaseLayout>

<style>
  .thoughts-layout {
    max-width: 620px;
  }

  .thoughts-head {
    margin-bottom: 3rem;
  }

  .back-home {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: 1.5rem;
    transition: color var(--transition);
  }

  .back-home:hover {
    color: var(--color-text-main);
  }

  .thoughts-title {
    font-size: 2.75rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-text-main);
  }

  .thoughts-sub {
    margin-top: 0.75rem;
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  .thoughts-admin {
    margin-bottom: 1rem;
  }

  .thoughts-export {
    margin-top: -1.5rem;
    margin-bottom: 2rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .thoughts-export a {
    color: var(--color-text-main);
  }

  .thought-card {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .thoughts-feed .thought-card:first-child {
    border-top: 1px solid var(--color-border);
  }

  .thought-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
  }

  .thought-date {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
  }

  .thought-tags {
    display: flex;
    gap: 0.4rem;
  }

  .thought-tag {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    background: var(--color-card-hover);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.15rem 0.5rem;
  }

  .thought-actions {
    margin-left: auto;
  }

  .thought-body {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-main);
  }

  .thought-body :global(p) {
    margin: 0;
  }

  .thought-body :global(p + p) {
    margin-top: 0.9em;
  }

  .thoughts-footer {
    padding: 1.75rem 0 0;
  }

  .thoughts-count {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  @media (width <= 640px) {
    .thoughts-title {
      font-size: 2.25rem;
    }
  }
</style>
