---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrowseLayout from '../../features/content-view/browse/BrowseLayout.astro';
import ContentFilterPanel from '../../features/content-view/browse/ContentFilterPanel.astro';
import ThoughtComposer from '../../features/thoughts/components/ThoughtComposer';
import ThoughtCard from '../../features/thoughts/components/ThoughtCard.astro';
import { loadCurrentUser } from '../../features/auth/current-session';
import { listThoughtsNewestFirst } from '../../features/thoughts/thought-store';
import { describeThoughtCount, toThoughtFeedItem } from '../../features/thoughts/thought-feed';
import { parseContentViewQuery } from '../../features/content-view/content-view-query';
import { countTags, selectContentForView } from '../../features/content-view/content-view-selection';
import { THOUGHTS_PAGE_PATH, thoughtSearchableText } from '../../features/thoughts/thought-view';

export const prerender = false;

const viewer = await loadCurrentUser(Astro.cookies);
const isAdmin = viewer?.isAdmin ?? false;
const visibleThoughts = await listThoughtsNewestFirst(env.DB, { includePrivate: isAdmin });
const query = parseContentViewQuery(Astro.url.searchParams, { viewerIsAdmin: isAdmin, allowedCategories: [] });
const feedItems = selectContentForView(visibleThoughts, query, thoughtSearchableText).map(toThoughtFeedItem);
Astro.response.headers.set('cache-control', 'no-store');
---

<BaseLayout title="Thoughts — Zichao Yang" description="Short thoughts, observations, and fragments.">
  <BrowseLayout title="Thoughts" subtitle="Short observations, posted as they come.">
    {isAdmin && (
      <p class="thoughts-export" slot="panel-actions">
        Export all:
        <a href="/api/thoughts/export?format=markdown" download>
          Markdown
        </a>
        ·
        <a href="/api/thoughts/export?format=json" download>
          JSON
        </a>
      </p>
    )}

    <ContentFilterPanel
      slot="filters"
      basePath={THOUGHTS_PAGE_PATH}
      query={query}
      tagCounts={countTags(visibleThoughts)}
      totalCount={visibleThoughts.length}
      showVisibilityFilter={isAdmin}
      searchLabel="Search thoughts"
      countLabel={describeThoughtCount(feedItems.length, visibleThoughts.length)}
    />

    {isAdmin && (
      <section class="thoughts-composer" aria-label="Post a thought">
        <ThoughtComposer client:load />
      </section>
    )}

    <div class="thoughts-feed">
      {feedItems.map((item) => (
        <ThoughtCard item={item} query={query} isAdmin={isAdmin} />
      ))}
    </div>
    {feedItems.length === 0 && visibleThoughts.length > 0 && <p class="thoughts-empty">No thoughts match.</p>}
  </BrowseLayout>
</BaseLayout>

<script>
  import { collapseLongThoughts } from '../../scripts/thoughts/collapse-long-thoughts';
  collapseLongThoughts(document);
</script>

<style>
  .thoughts-export {
    display: flex;
    gap: 0.4rem;
    margin-top: 1rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .thoughts-export a {
    color: var(--color-text-main);
  }

  .thoughts-composer {
    max-width: calc(700px + 120px + 4rem);
    margin-bottom: 3rem;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 14px;
  }

  .thoughts-composer :global(.thought-composer) {
    margin-bottom: 0;
  }

  .thoughts-empty {
    padding: 3rem 0;
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
