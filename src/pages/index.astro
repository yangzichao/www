---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import WorkCard, { type WorkCardTone } from '../components/WorkCard.astro';
import Footer from '../components/Footer.astro';
import { siteData } from '../data/site';

const workCardToneCycle: WorkCardTone[] = ['violet', 'coral', 'green', 'neutral'];
const toneForPosition = (position: number): WorkCardTone =>
  workCardToneCycle[position % workCardToneCycle.length] ?? 'neutral';
---

<BaseLayout>
  <Header profile={siteData.profile} sitePages={siteData.sitePages} />

  <section>
    <h2 class="section-title" data-depth-reveal>
      Public Interface
    </h2>
    <div class="work-grid" data-depth-stagger data-scroll-tilt>
      {siteData.items.map((item, position) => (
        <div class="work-grid-item" data-depth-reveal>
          <WorkCard item={item} tone={toneForPosition(position)} />
        </div>
      ))}
    </div>
  </section>

  <Footer />
</BaseLayout>
