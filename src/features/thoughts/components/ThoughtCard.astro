---
import ThoughtAdminControls from './ThoughtAdminControls';
import type { ThoughtFeedItem } from '../thought-feed';
import { buildContentViewHref, type ContentViewQuery } from '../../content-view/content-view-query';
import { THOUGHTS_PAGE_PATH, thoughtAnchorId } from '../thought-view';
import './thought-card.css';

interface Props {
  item: ThoughtFeedItem;
  query: ContentViewQuery;
  isAdmin: boolean;
}

const { item, query, isAdmin } = Astro.props;
const anchorId = thoughtAnchorId(item.id);
---

<article
  class="thought-card"
  id={anchorId}
  data-thought-id={item.id}
  data-visibility={item.isPublic ? 'public' : 'private'}
>
  <div class="thought-gutter">
    <a class="thought-permalink" href={`#${anchorId}`} aria-label="Permalink to this thought">
      <time class="thought-date" datetime={item.createdAt}>
        {item.displayTimestamp}
      </time>
    </a>
    {item.updatedAt && (
      <span class="thought-edited">
        Edited <time datetime={item.updatedAt}>{item.displayEditedTimestamp}</time>
      </span>
    )}
  </div>
  <div class="thought-main">
    <div class="thought-body prose" data-thought-body set:html={item.html} />
    {(item.tags.length > 0 || !item.isPublic) && (
      <div class="thought-tags">
        {!item.isPublic && <span class="thought-private">Private</span>}
        {item.tags.map((tag) => (
          <a class="thought-tag" href={buildContentViewHref(THOUGHTS_PAGE_PATH, query, { tag })}>
            {tag}
          </a>
        ))}
      </div>
    )}
    {isAdmin && (
      <ThoughtAdminControls
        client:visible
        thoughtId={item.id}
        body={item.body}
        tags={item.tags}
        isPublic={item.isPublic}
      />
    )}
  </div>
</article>
