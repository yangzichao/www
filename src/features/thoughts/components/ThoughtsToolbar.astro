---
import { Input } from '@/components/ui/input';
import {
  buildThoughtViewHref,
  isFilteredThoughtView,
  type ThoughtSortOrder,
  type ThoughtViewQuery,
  type ThoughtVisibilityFilter,
} from '../view/thought-view-query';
import type { ThoughtTagCount } from '../view/thought-view-selection';

interface Props {
  query: ThoughtViewQuery;
  tagCounts: ThoughtTagCount[];
  showVisibilityFilter: boolean;
}

const { query, tagCounts, showVisibilityFilter } = Astro.props;

const sortChoices: { value: ThoughtSortOrder; label: string }[] = [
  { value: 'newest', label: 'Newest' },
  { value: 'oldest', label: 'Oldest' },
  { value: 'recently-edited', label: 'Recently edited' },
];

const visibilityChoices: { value: ThoughtVisibilityFilter; label: string }[] = [
  { value: 'all', label: 'All' },
  { value: 'public', label: 'Public' },
  { value: 'private', label: 'Private' },
];
---

<nav class="thoughts-toolbar" aria-label="Sort and filter thoughts">
  <form class="toolbar-search" method="get" action="/thoughts/" role="search">
    {query.sort !== 'newest' && <input type="hidden" name="sort" value={query.sort} />}
    {query.tag !== null && <input type="hidden" name="tag" value={query.tag} />}
    {query.visibility !== 'all' && <input type="hidden" name="visibility" value={query.visibility} />}
    <Input type="search" name="q" value={query.search} placeholder="Search thoughts" aria-label="Search thoughts" />
  </form>

  <div class="toolbar-row">
    <span class="toolbar-label">Sort</span>
    {sortChoices.map((choice) => (
      <a
        class="toolbar-choice"
        href={buildThoughtViewHref(query, { sort: choice.value })}
        aria-current={query.sort === choice.value ? 'true' : undefined}
      >
        {choice.label}
      </a>
    ))}
  </div>

  {showVisibilityFilter && (
    <div class="toolbar-row">
      <span class="toolbar-label">Show</span>
      {visibilityChoices.map((choice) => (
        <a
          class="toolbar-choice"
          href={buildThoughtViewHref(query, { visibility: choice.value })}
          aria-current={query.visibility === choice.value ? 'true' : undefined}
        >
          {choice.label}
        </a>
      ))}
    </div>
  )}

  {tagCounts.length > 0 && (
    <div class="toolbar-row">
      <span class="toolbar-label">Tag</span>
      <a
        class="toolbar-choice"
        href={buildThoughtViewHref(query, { tag: null })}
        aria-current={query.tag === null ? 'true' : undefined}
      >
        Any
      </a>
      {tagCounts.map(({ tag, count }) => (
        <a
          class="toolbar-choice"
          href={buildThoughtViewHref(query, { tag })}
          aria-current={query.tag === tag ? 'true' : undefined}
        >
          {tag} <span class="toolbar-count">{count}</span>
        </a>
      ))}
    </div>
  )}

  {isFilteredThoughtView(query) && (
    <a class="toolbar-clear" href={buildThoughtViewHref(query, { tag: null, visibility: 'all', search: '' })}>
      Clear filters
    </a>
  )}
</nav>

<style>
  .thoughts-toolbar {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 2rem;
    font-size: 0.85rem;
  }

  .toolbar-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
  }

  .toolbar-label {
    min-width: 2.5rem;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .toolbar-choice {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition);
  }

  .toolbar-choice:hover {
    color: var(--color-text-main);
  }

  .toolbar-choice[aria-current='true'] {
    color: var(--color-text-main);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .toolbar-count {
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }

  .toolbar-clear {
    align-self: flex-start;
    color: var(--color-text-main);
  }
</style>
