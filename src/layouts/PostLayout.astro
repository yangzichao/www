---
import BaseLayout from './BaseLayout.astro';
import BlogSidebar from '../components/BlogSidebar.astro';
import TableOfContentsRail from '../components/blog/TableOfContentsRail.astro';
import TableOfContentsInline from '../components/blog/TableOfContentsInline.astro';
import CommentsSection from '../features/comments/components/CommentsSection';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { postsInSection, groupByCategory, getAdjacentPostsInCategory, categoryOfId, categoryLabel } from '../lib/posts';
import { categoryUrl, postUrl, WRITING_SECTION, type PostSection } from '../lib/post-sections';
import { shouldShowToc } from '../lib/toc';
import 'katex/dist/katex.min.css';
import '../styles/post.css';
import '../styles/whiteboard-diagram.css';
import '../styles/blog-layout.css';
import '../styles/print.css';

interface Props {
  frontmatter: CollectionEntry<'blog'>['data'];
  id: string;
  headings?: MarkdownHeading[];
  section?: PostSection;
}

const { frontmatter, id, headings = [], section = WRITING_SECTION } = Astro.props;

const posts = await postsInSection(section);
const groups = groupByCategory(posts);
const adjacent = getAdjacentPostsInCategory(posts, id);

const categorySlug = categoryOfId(id);
const categoryName = categoryLabel(categorySlug);

const hasTableOfContents = shouldShowToc(headings);

/* External: the YAML loader parses a date-only frontmatter value like
 * `2026-05-02` as midnight UTC, so formatting in local time would show the
 * previous day in any negative-offset timezone. */
const formattedDate = frontmatter.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const isoDate = frontmatter.date.toISOString();
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description ?? frontmatter.title}
  recordsPageView={section.isPublic}
>
  <div class:list={['blog-layout', { 'has-toc': hasTableOfContents }]}>
    <BlogSidebar groups={groups} currentId={id} section={section} />
    <div class="blog-main">
      <TableOfContentsInline headings={headings} />
      <article class="prose prose-lg post-article">
        <header class="not-prose post-header">
          <button type="button" class="pdf-download" aria-label="Download this post as PDF" onclick="window.print()">
            <i class="ph ph-file-pdf" aria-hidden="true"></i>
            <span>Download PDF</span>
          </button>
          <nav class="post-breadcrumb" aria-label="Breadcrumb">
            <a href={section.basePath}>{section.label}</a>
            <span class="post-breadcrumb-separator" aria-hidden="true">
              /
            </span>
            <a href={categoryUrl(section, categorySlug)}>{categoryName}</a>
          </nav>
          <h1 class="post-title">{frontmatter.title}</h1>
          <div class="post-meta">
            <time datetime={isoDate}>{formattedDate}</time>
            {frontmatter.venue && <span class="post-meta-separator">·</span>}
            {frontmatter.venue && <span class="post-venue">{frontmatter.venue}</span>}
            {section.isPublic && (
              <span class="post-views" data-page-view-count hidden>
                <span class="post-meta-separator">·</span>
                <span data-page-view-count-value></span>
              </span>
            )}
            {frontmatter.draft && <span class="post-meta-separator">·</span>}
            {frontmatter.draft && <span class="post-draft-badge">Draft</span>}
          </div>
          {frontmatter.tags.length > 0 && (
            <ul class="post-tags">
              {frontmatter.tags.map((tag) => (
                <li class="post-tag">{tag}</li>
              ))}
            </ul>
          )}
        </header>
        <slot />
      </article>

      {section.isPublic && <CommentsSection client:visible pagePath={postUrl(section, id)} />}

      {(adjacent.newer || adjacent.older) && (
        <nav class="post-pager" aria-label={`More in ${categoryName}`}>
          {adjacent.newer ? (
            <a class="post-pager-link post-pager-newer" href={postUrl(section, adjacent.newer.id)}>
              <span class="post-pager-direction">← Newer in {categoryName}</span>
              <span class="post-pager-title">{adjacent.newer.data.title}</span>
            </a>
          ) : (
            <span class="post-pager-spacer" />
          )}
          {adjacent.older && (
            <a class="post-pager-link post-pager-older" href={postUrl(section, adjacent.older.id)}>
              <span class="post-pager-direction">Older in {categoryName} →</span>
              <span class="post-pager-title">{adjacent.older.data.title}</span>
            </a>
          )}
        </nav>
      )}
    </div>
    <TableOfContentsRail headings={headings} />
  </div>

  <script>
    import { initTocScrollSpy } from '../scripts/blog/toc-scroll-spy';
    import { initHeadingAnchorLinks } from '../scripts/blog/heading-anchor-links';
    initHeadingAnchorLinks();
    initTocScrollSpy();
  </script>
</BaseLayout>

<style>
  .post-header {
    position: relative;
    font-family: var(--font-sans);
    margin-bottom: 3rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .pdf-download {
    position: absolute;
    top: 0;
    right: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 550;
    color: var(--color-text-main);
    background: var(--color-surface-control);
    border: 0;
    border-radius: var(--radius);
    cursor: pointer;
    transition:
      color var(--transition),
      border-color var(--transition),
      background var(--transition);
  }

  .pdf-download:hover {
    background: var(--color-surface-control-hover);
  }

  .pdf-download i {
    font-size: 1rem;
    line-height: 1;
  }

  @media (width <= 600px) {
    .pdf-download {
      position: static;
      margin-bottom: 1rem;
    }

    .pdf-download span {
      display: inline;
    }
  }

  .post-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    margin-bottom: 1rem;
    color: var(--color-text-muted);
  }

  .post-breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition);
  }

  .post-breadcrumb a:hover {
    color: var(--color-text-main);
  }

  .post-breadcrumb-separator {
    opacity: 0.45;
  }

  .post-title {
    font-family: var(--font-heading);
    font-size: 2.875rem;
    font-weight: var(--font-weight-heading);
    letter-spacing: 0.01em;
    line-height: 1.18;
    margin: 0 0 1rem;
    color: var(--color-text-main);
    text-wrap: balance;
  }

  .post-meta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .post-meta-separator {
    opacity: 0.5;
  }

  .post-venue {
    font-family: var(--font-editorial);
    font-size: 0.95rem;
    font-style: italic;
  }

  .post-draft-badge {
    font-size: 0.7rem;
    padding: 2px 6px;
    color: var(--tone-coral-ink);
    background: var(--tone-coral-surface);
    border-radius: 4px;
  }

  .post-views {
    display: contents;
  }

  .post-tags {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .post-tag {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 1px 8px;
    color: var(--tone-violet-ink);
    background: var(--tone-violet-soft);
    border: 1px solid var(--tone-violet-border);
    border-radius: 5px;
  }

  .post-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-sans);
  }

  .post-pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.25rem;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
    text-decoration: none;
    transition:
      border-color var(--transition),
      background var(--transition);
  }

  .post-pager-link:hover {
    border-color: var(--color-border-strong);
    background: var(--color-surface-sunken);
  }

  .post-pager-older {
    text-align: right;
  }

  .post-pager-direction {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .post-pager-title {
    font-size: 0.95rem;
    font-weight: 550;
    line-height: 1.35;
    color: var(--color-text-main);
  }

  @media (width <= 600px) {
    .post-pager {
      grid-template-columns: 1fr;
    }

    .post-pager-spacer {
      display: none;
    }

    .post-pager-older {
      text-align: left;
    }
  }
</style>
