---
import BaseLayout from './BaseLayout.astro';
import BlogSidebar from '../components/BlogSidebar.astro';
import TableOfContentsRail from '../components/blog/TableOfContentsRail.astro';
import TableOfContentsInline from '../components/blog/TableOfContentsInline.astro';
import CommentsSection from '../features/comments/components/CommentsSection';
import PostPagerLink from '../components/blog/post-pager/PostPagerLink';
import { cn } from 'cn';
import { badgeVariants } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { categoryLabel } from '../features/posts/post-categories';
import { formatPostCreatedDate, formatPostEditedDate } from '../features/posts/post-date-format';
import { adjacentPostsInCategory, groupByCategory } from '../features/posts/post-grouping';
import { BLOG_BASE_PATH, categoryOfPostPath, postUrl } from '../features/posts/post-path';
import type { Post, PostSummary } from '../features/posts/post-types';
import { editPostUrl } from '../features/posts/post-view';
import { shouldShowToc } from '../lib/toc';
import 'katex/dist/katex.min.css';
import '../styles/post.css';
import '../styles/whiteboard-diagram.css';
import '../styles/blog-layout.css';
import '../styles/print.css';

interface Props {
  post: Post;
  visiblePosts: PostSummary[];
  isAdmin: boolean;
}

const { post, visiblePosts, isAdmin } = Astro.props;

const groups = groupByCategory(visiblePosts);
const adjacent = adjacentPostsInCategory(visiblePosts, post.path);

const categorySlug = categoryOfPostPath(post.path);
const categoryName = categoryLabel(categorySlug);

const hasTableOfContents = shouldShowToc(post.headings);
const formattedDate = formatPostCreatedDate(post, 'long');
const formattedEditedDate = post.updatedAt ? formatPostEditedDate(post.updatedAt, 'long') : null;
const pdfDownloadButtonClass = cn(
  buttonVariants({ variant: 'outline', size: 'sm' }),
  'pdf-download h-auto bg-clip-border leading-[inherit]',
);
const postTagClass = cn(
  badgeVariants({ variant: 'secondary' }),
  'post-tag h-auto border-0 font-normal leading-[inherit]',
);
---

<BaseLayout title={post.title} description={post.description ?? post.title} recordsPageView={post.isPublic}>
  <div class:list={['blog-layout', { 'has-toc': hasTableOfContents }]}>
    <BlogSidebar groups={groups} currentPath={post.path} />
    <div class="blog-main">
      <TableOfContentsInline headings={post.headings} />
      <article class="prose prose-lg post-article">
        <header class="not-prose post-header">
          <button
            type="button"
            class={pdfDownloadButtonClass}
            aria-label="Download this post as PDF"
            onclick="window.print()"
          >
            <i class="ph ph-file-pdf" aria-hidden="true"></i>
            <span>Download PDF</span>
          </button>
          <nav class="post-breadcrumb" aria-label="Breadcrumb">
            <a href={BLOG_BASE_PATH}>Writing</a>
            <span class="post-breadcrumb-separator" aria-hidden="true">
              /
            </span>
            <a href={`${BLOG_BASE_PATH}#${categorySlug}`}>{categoryName}</a>
          </nav>
          <h1 class="post-title">{post.title}</h1>
          <div class="post-meta">
            <time datetime={post.createdAt}>{formattedDate}</time>
            {post.updatedAt && formattedEditedDate && (
              <span class="post-edited">
                <span class="post-meta-separator">·</span>
                Edited <time datetime={post.updatedAt}>{formattedEditedDate}</time>
              </span>
            )}
            {post.venue && <span class="post-meta-separator">·</span>}
            {post.venue && <span class="post-venue">{post.venue}</span>}
            {post.isPublic && (
              <span class="post-views" data-page-view-count hidden>
                <span class="post-meta-separator">·</span>
                <span data-page-view-count-value></span>
              </span>
            )}
            {!post.isPublic && <span class="post-meta-separator">·</span>}
            {!post.isPublic && <span class="post-private-badge">Private</span>}
            {isAdmin && <span class="post-meta-separator">·</span>}
            {isAdmin && (
              <a class="post-edit-link" href={editPostUrl(post.id)}>
                Edit
              </a>
            )}
          </div>
          {post.tags.length > 0 && (
            <ul class="post-tags">
              {post.tags.map((tag) => (
                <li class={postTagClass}>
                  <a href={`${BLOG_BASE_PATH}?tag=${encodeURIComponent(tag)}`}>{tag}</a>
                </li>
              ))}
            </ul>
          )}
        </header>
        <Fragment set:html={post.bodyHtml} />
      </article>

      {post.isPublic && <CommentsSection client:visible pagePath={postUrl(post.path)} />}

      {(adjacent.newer || adjacent.older) && (
        <nav class="post-pager" aria-label={`More in ${categoryName}`}>
          {adjacent.newer ? (
            <PostPagerLink
              href={postUrl(adjacent.newer.path)}
              direction="newer"
              categoryName={categoryName}
              postTitle={adjacent.newer.title}
            />
          ) : (
            <span class="post-pager-spacer" />
          )}
          {adjacent.older && (
            <PostPagerLink
              href={postUrl(adjacent.older.path)}
              direction="older"
              categoryName={categoryName}
              postTitle={adjacent.older.title}
            />
          )}
        </nav>
      )}
    </div>
    <TableOfContentsRail headings={post.headings} />
  </div>

  <script>
    import { initTocScrollSpy } from '../scripts/blog/toc-scroll-spy';
    import { initHeadingAnchorLinks } from '../scripts/blog/heading-anchor-links';
    initHeadingAnchorLinks();
    initTocScrollSpy();
  </script>
</BaseLayout>

<style>
  .post-header {
    position: relative;
    font-family: var(--font-stack);
    margin-bottom: 3rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border, #e5e5e5);
  }

  .pdf-download {
    position: absolute;
    top: 0;
    right: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    font-family: var(--font-stack);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-muted, #666);
    background: var(--color-background, #fff);
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: 999px;
    cursor: pointer;
    transition:
      color var(--transition, 0.15s ease),
      border-color var(--transition, 0.15s ease),
      background var(--transition, 0.15s ease);
  }

  .pdf-download:hover {
    color: var(--color-text-main, #111);
    border-color: var(--color-text-muted, #999);
    background: var(--color-card-hover, #f6f6f4);
  }

  .pdf-download i {
    font-size: 1rem;
    line-height: 1;
  }

  @media (width <= 600px) {
    .pdf-download {
      position: static;
      margin-bottom: 1rem;
    }

    .pdf-download span {
      display: inline;
    }
  }

  .post-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    margin-bottom: 1rem;
    color: var(--color-text-muted, #666);
  }

  .post-tag a {
    color: inherit;
    text-decoration: none;
  }

  .post-breadcrumb a {
    color: var(--color-text-muted, #666);
    text-decoration: none;
    transition: color var(--transition, 0.15s ease);
  }

  .post-breadcrumb a:hover {
    color: var(--color-text-main, #111);
  }

  .post-breadcrumb-separator {
    opacity: 0.45;
  }

  .post-title {
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.12;
    margin: 0 0 0.85rem;
    color: var(--color-text-main, #111);
    text-wrap: balance;
  }

  .post-meta {
    font-size: 0.875rem;
    color: var(--color-text-muted, #666);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .post-meta-separator {
    opacity: 0.5;
  }

  .post-venue {
    font-style: italic;
  }

  .post-edited {
    display: contents;
    font-style: italic;
  }

  .post-edit-link {
    color: var(--color-text-main, #111);
  }

  .post-private-badge {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.75rem;
  }

  .post-views {
    display: contents;
  }

  .post-tags {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .post-tag {
    font-size: 0.75rem;
    padding: 2px 8px;
    background: #f3f3f3;
    border-radius: 4px;
    color: var(--color-text-muted, #666);
  }

  .post-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border, #e5e5e5);
    font-family: var(--font-stack);
  }

  @media (width <= 600px) {
    .post-pager {
      grid-template-columns: 1fr;
    }

    .post-pager-spacer {
      display: none;
    }
  }
</style>
