---
import '../styles/global.css';
import '../styles/effects/depth-3d.css';

interface Props {
  title?: string;
  description?: string;
  recordsPageView?: boolean;
}

const {
  title = 'Zichao Yang',
  description = 'Personal homepage of Zichao Yang — researcher and developer.',
  recordsPageView = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css" />

    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('depth-effects-enabled');
      }
    </script>
  </head>

  <body data-records-page-view={recordsPageView ? undefined : 'false'}>
    <main class="container">
      <slot />
    </main>
    <slot name="body-end" />
    <script>
      import { initDepthEffects } from '../scripts/effects/init-depth-effects';
      import { recordPageView } from '../scripts/page-views/record-page-view';
      initDepthEffects();
      recordPageView();
    </script>
  </body>
</html>
