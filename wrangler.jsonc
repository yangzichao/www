{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-11-17",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "zichaoyang-com",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "zichaoyang-com",
			"database_id": "ebf878c4-4c97-440d-b50b-7d8410fb11f8",
			"migrations_dir": "migrations"
		}
	],
	"routes": [
		{ "pattern": "zichaoyang.com", "custom_domain": true }
	],
	"observability": {
		"enabled": true
	}
}
